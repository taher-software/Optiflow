# Frontend URL used to build the email-confirmation link (note the trailing slash).
FRONTEND_URL=http://localhost:5173/

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=OptiFlow <onboarding@optiflow.app>

# Security — used to sign email-confirmation tokens. MUST be set in production.
SECRET_KEY=change-me-in-production

# Google Cloud / Firestore
# Uses the default service-account credentials (Application Default Credentials).
# Set GOOGLE_APPLICATION_CREDENTIALS to your service-account key file path.
GOOGLE_APPLICATION_CREDENTIALS=
