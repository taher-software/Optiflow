{
  "expo": {
    "name": "OptiFlow",
    "slug": "optiflow",
    "owner": "azibodin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.azibodin.optiflow.app"
    },
    "android": {
      "package": "com.azibodin.optiflow.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-localization",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/urgent.wav",
            "./assets/sounds/standard.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "efbd63ec-95cf-483c-9966-11ab923120f5"
      }
    },
    "icon": "./assets/icon.png"
  }
}
