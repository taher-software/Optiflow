{
  "expo": {
    "name": "OptiFlow",
    "slug": "optiflow",
    "owner": "azibodin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#020617"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ttaherhagui.optiflow"
    },
    "android": {
      "package": "com.ttaherhagui.optiflow",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-localization",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/urgent.wav",
            "./assets/sounds/standard.wav"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "efbd63ec-95cf-483c-9966-11ab923120f5"
      }
    }
  }
}
